---
import { site } from "../data/site";
import SectionHeader from "./SectionHeader.astro";
import { isLive } from "../lib/util";
import Text from "./Text.astro";
---
<section id="certifications" class="section" aria-labelledby="certs-title">
  <div class="wrap">
    <SectionHeader fig="05" label="Certifications" id="certs-title" title="Always learning, on the record." />
    <ul class="certs card">
      {site.certifications.map((c) => (
        <li class:list={["cert", c.status]}>
          <span class="date mono"><Text value={c.date} /></span>
          <div class="what">
            <h3>
              {isLive(c.href)
                ? <a href={c.href} target="_blank" rel="noopener noreferrer">{c.name}<span class="visually-hidden"> credential (opens in a new tab)</span></a>
                : c.name}
            </h3>
            <p class="issuer"><Text value={c.issuer} /></p>
          </div>
          <span class="status mono">{c.status === "completed" ? "completed" : "in progress"}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .certs { list-style: none; padding: 0 var(--space-l); }
  .cert {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "date status" "what what";
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-l);
    align-items: center;
  }
  .cert + .cert { border-top: 1px dashed var(--border); }
  .date { grid-area: date; font-size: var(--step--1); color: var(--muted); }
  .what { grid-area: what; }
  h3 { font-size: var(--step-1); line-height: 1.3; }
  .issuer { color: var(--muted); margin-top: var(--space-2xs); }
  .status {
    grid-area: status; justify-self: end;
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;
    padding: 0.2rem 0.55rem; border-radius: 999px;
    color: var(--signal); background: var(--signal-soft);
  }
  .in-progress .status { color: var(--highlight); background: var(--highlight-soft); }
  .in-progress .status::before {
    content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 0.45em;
    border-radius: 50%; background: currentColor; vertical-align: 0.1em;
    animation: blink 1.6s ease-in-out infinite;
  }
  @keyframes blink { 50% { opacity: 0.25; } }
  @media (min-width: 48rem) {
    .cert { grid-template-columns: 9rem 1fr auto; grid-template-areas: "date what status"; }
  }
</style>
