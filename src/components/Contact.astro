---
import { site } from "../data/site";
const { person, contact, social } = site;
const subject = encodeURIComponent("Hello from your portfolio");
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="card box">
      <p class="eyebrow"><span class="fig">Fig. 07</span> — Contact</p>
      <h2 id="contact-title">{contact.title}</h2>
      <p class="text">{contact.text}</p>
      <a class="email mono" href={`mailto:${person.email}?subject=${subject}`}>{person.email}</a>
      <ul class="actions">
        <li><a class="btn btn-primary" href={`mailto:${person.email}?subject=${subject}`}>Email me</a></li>
        <li><a class="btn btn-ghost" href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a class="btn btn-ghost" href={social.github} target="_blank" rel="noopener noreferrer">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a class="btn btn-ghost" href="/cv.pdf" download>Download CV<span class="visually-hidden"> (PDF)</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .box {
    display: grid; gap: var(--space-l);
    padding: clamp(1.5rem, 1rem + 4vw, 4rem);
    background:
      radial-gradient(120% 120% at 100% 0%, var(--signal-soft), transparent 55%),
      var(--surface);
  }
  .fig { color: var(--signal); }
  h2 { font-size: var(--step-3); max-width: 20ch; }
  .text { color: var(--muted); font-size: var(--step-1); max-width: 52ch; line-height: 1.5; }
  .email {
    font-size: clamp(1.15rem, 0.8rem + 2.2vw, 2.25rem);
    font-weight: 600;
    color: var(--signal);
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
    width: fit-content;
  }
  .actions { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-s); }
  .actions li { flex: 1 1 10rem; }
  .actions .btn { width: 100%; }
  @media (min-width: 48rem) { .actions li { flex: 0 0 auto; } }
</style>
