---
import { site } from "../data/site";
const { hero, person, kpis } = site;

// Deterministic "noisy but rising" series for the decorative sparkline.
const N = 48;
const W = 1000;
const H = 120;
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const values = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1);
  const trend = Math.pow(t, 1.6) * 0.78;
  const noise = (rand() - 0.5) * 0.16 * (1 - t * 0.6);
  return Math.min(0.95, Math.max(0.05, 0.1 + trend + noise));
});
const pts = values.map((v, i) => [(i / (N - 1)) * W, H - v * H] as const);
const line = pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
const area = `${line} L${W} ${H} L0 ${H} Z`;
const [lx, ly] = pts[pts.length - 1];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{person.name} · {hero.eyebrow}</p>
      <h1 id="hero-title">{hero.title} <span class="hl">{hero.highlight}</span></h1>
      <p class="sub">{hero.subtitle}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={hero.primaryCta.href}>
          {hero.primaryCta.label}
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn btn-ghost" href={hero.secondaryCta.href} download>
          {hero.secondaryCta.label}
          <span class="visually-hidden">(PDF)</span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2v9M4 7l4 4 4-4M3 14h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <aside class="panel card" aria-label="Summary">
      <div class="panel-head mono">
        <span>summary.kpi</span>
        <span class="live"><span class="dot" aria-hidden="true"></span>2026</span>
      </div>
      <dl class="kpis">
        {kpis.map((k) => (
          <div class="kpi">
            <dt>{k.label}</dt>
            <dd class="mono"><span class="v">{k.value}</span>{k.unit && <span class="u">{k.unit}</span>}</dd>
          </div>
        ))}
      </dl>
    </aside>

    <figure class="spark" aria-hidden="true">
      <div class="plot">
      <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} preserveAspectRatio="none">
        <defs>
          <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="var(--signal)" stop-opacity="0.22" />
            <stop offset="1" stop-color="var(--signal)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path class="area" d={area} fill="url(#spark-fill)" />
        <path class="line" d={line} fill="none" stroke="var(--signal)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
      </svg>
      <span class="end" style={`left:${(lx / W) * 100}%;top:${(ly / H) * 100}%`}></span>
      <span class="note mono" style={`top:${(ly / H) * 100}%`}>→ {hero.pipeline.at(-1)}</span>
      </div>
      <ol class="xaxis mono">
        {hero.pipeline.map((p) => <li>{p}</li>)}
      </ol>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) var(--space-xl); }
  .grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-areas: "copy" "panel" "spark";
  }
  .copy { grid-area: copy; display: grid; gap: var(--space-l); align-content: start; }
  .eyebrow { text-transform: none; letter-spacing: 0.02em; }
  .eyebrow .dot { margin-right: 0.6em; vertical-align: 0.05em; }
  .dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%;
    background: var(--signal); box-shadow: 0 0 0 4px var(--signal-soft);
  }
  h1 { font-size: var(--step-4); font-weight: 700; letter-spacing: -0.035em; line-height: 1.02; max-width: 14ch; }
  .hl {
    color: var(--signal);
    background: linear-gradient(transparent 78%, var(--highlight-soft) 78%);
  }
  .sub { color: var(--muted); font-size: var(--step-1); line-height: 1.5; max-width: 52ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-s); }
  .ctas .btn { flex: 1 1 12rem; }

  .panel { grid-area: panel; padding: var(--space-m); align-self: start; }
  .panel-head {
    display: flex; justify-content: space-between; align-items: center;
    font-size: var(--step--1); color: var(--muted);
    padding-bottom: var(--space-s); margin-bottom: var(--space-s);
    border-bottom: 1px dashed var(--border);
  }
  .live { display: inline-flex; align-items: center; gap: 0.5em; }
  .live .dot { width: 6px; height: 6px; box-shadow: 0 0 0 3px var(--signal-soft); }
  .kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 0; background: var(--border); border-radius: var(--radius); overflow: hidden; }
  .kpi { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-2xs); padding: var(--space-m); background: var(--surface); }
  .kpi dt { font-size: var(--step--1); color: var(--muted); line-height: 1.3; }
  .kpi dd { margin: 0; line-height: 1; }
  .v { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; }
  .u { margin-left: 0.2em; font-size: var(--step-0); color: var(--signal); }
  .kpi:first-child .v { color: var(--signal); }

  .spark { grid-area: spark; margin: 0; padding-top: var(--space-l); }
  .plot { position: relative; }
  .spark svg { width: 100%; height: clamp(70px, 10vw, 120px); overflow: visible; }
  /* Reveal via a composited transform (cheap) instead of animating the stroke */
  .plot::after {
    content: ""; position: absolute; inset: -12px -12px -4px 0;
    background: var(--bg); transform-origin: right center;
    animation: reveal 1.8s 0.2s cubic-bezier(.6,.1,.2,1) forwards;
  }
  .end, .note { position: absolute; z-index: 1; }
  .end {
    width: 10px; height: 10px; margin: -5px 0 0 -5px;
    border-radius: 50%; background: var(--highlight);
    box-shadow: 0 0 0 5px var(--highlight-soft);
    opacity: 0; animation: fade 0.4s 1.9s ease forwards;
  }
  .note {
    right: 0; transform: translate(0, -180%);
    font-size: var(--step--1); color: var(--highlight); font-weight: 600;
    opacity: 0; animation: fade 0.4s 2s ease forwards; z-index: 1;
  }
  .xaxis {
    display: flex; justify-content: space-between; list-style: none;
    margin-top: var(--space-s); padding-top: var(--space-xs);
    border-top: 1px solid var(--border);
    font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;
  }
  .xaxis li { position: relative; }
  .xaxis li::before { content: ""; position: absolute; top: calc(-1 * var(--space-xs) - 5px); left: 50%; width: 1px; height: 5px; background: var(--border); }
  .xaxis li:first-child::before { left: 0; }
  .xaxis li:last-child::before { left: auto; right: 0; }
  .xaxis li:last-child { color: var(--highlight); }

  @keyframes reveal { to { transform: scaleX(0); } }
  @keyframes fade { to { opacity: 1; } }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 7fr 5fr;
      grid-template-areas: "copy panel" "spark spark";
      column-gap: var(--space-2xl);
    }
    .panel { margin-top: var(--space-xl); }
    .ctas .btn { flex: 0 0 auto; }
  }
</style>
