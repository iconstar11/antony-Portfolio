---
interface Props {
  fig: string;
  label: string;
  title: string;
  id: string;
  lede?: string;
}
const { fig, label, title, id, lede } = Astro.props;
---
<div class="sh">
  <p class="eyebrow"><span class="fig">Fig. {fig}</span> — {label}</p>
  <h2 id={id}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
  <div class="axis" aria-hidden="true"></div>
</div>

<style>
  .sh { display: grid; gap: var(--space-s); margin-bottom: var(--space-xl); }
  .fig { color: var(--signal); }
  h2 { font-size: var(--step-3); max-width: 22ch; }
  .lede { color: var(--muted); max-width: 60ch; font-size: var(--step-1); line-height: 1.45; }
  /* x-axis with tick marks */
  .axis {
    height: 9px;
    margin-top: var(--space-xs);
    border-top: 1px solid var(--border);
    background: repeating-linear-gradient(90deg, var(--border) 0 1px, transparent 1px 48px);
    mask-image: linear-gradient(90deg, #000 60%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 60%, transparent);
  }
</style>
