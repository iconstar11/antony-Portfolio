<button id="theme-toggle" class="toggle" type="button" aria-pressed="false">
  <span class="visually-hidden">Dark mode</span>
  <svg class="icon sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8" />
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  </svg>
</button>

<script is:inline>
  (function () {
    var b = document.getElementById("theme-toggle");
    var r = document.documentElement;
    function sync() {
      b.setAttribute("aria-pressed", r.dataset.theme === "dark" ? "true" : "false");
    }
    sync();
    b.addEventListener("click", function () {
      var t = r.dataset.theme === "dark" ? "light" : "dark";
      r.dataset.theme = t;
      try { localStorage.setItem("theme", t); } catch (e) {}
      sync();
    });
    // Follow OS changes until the visitor makes an explicit choice.
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
      try { if (localStorage.getItem("theme")) return; } catch (_) {}
      r.dataset.theme = e.matches ? "dark" : "light";
      sync();
    });
  })();
</script>

<style>
  .toggle {
    grid-area: toggle;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .toggle:hover { border-color: var(--signal); }
  .icon { grid-area: 1 / 1; }
  /* Show the icon of the theme you'd switch TO */
  .sun { display: none; }
  :global([data-theme="dark"]) .sun { display: block; }
  :global([data-theme="dark"]) .moon { display: none; }
  /* Without JS the toggle can't work, so hide it (system preference still applies) */
  :global(:root:not([data-theme])) .toggle { visibility: hidden; }
</style>
